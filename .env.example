# Default provider/model used when not overridden with --provider/--model.
CODECONTEXT_PROVIDER=ollama
CODECONTEXT_MODEL=llama3

# Required for --provider ollama (default, fully local).
OLLAMA_HOST=http://localhost:11434

# Required for --provider anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Required for --provider openai.
OPENAI_API_KEY=sk-...
